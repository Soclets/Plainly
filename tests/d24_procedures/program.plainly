proc heal(Whole health, amount, times) returns Whole:
    labels amount as by, times as times;
    return health + amount * times;
end proc heal

proc larger(Whole a, b) returns Whole:
    if a > b:
        return a;
    else:
        return b;
    end if
end proc larger

proc show_if_positive(n: Whole):
    if n at_most 0:
        return;
    else:
        show_msg(be.Text(n));
    end if
end proc show_if_positive

proc.main:
    show_msg(be.Text(heal(50, by: 10, times: 2)));
    show_msg(be.Text(larger(3, 9)));
    show_if_positive(-1);
    show_if_positive(5);
end proc.main
