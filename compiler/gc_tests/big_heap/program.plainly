proc keep(n: Whole) returns Text:
    if n == 0:
        return "end";
    else:
        let rest: Text = keep(n - 1);
        return be.Text(n) & " " & rest;
    end if
end proc keep

proc.main:
    var total: Text = "";
    var round: Whole = 0;
    while round < 40:
        let chunk: Text = keep(500);
        total = chunk;
        var n: Whole = 0;
        while n < 5000:
            let garbage: Text = "garbage " & be.Text(n);
            n = n + 1;
        end while
        round = round + 1;
    end while
    show_msg(total);
end proc.main
