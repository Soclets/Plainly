proc build(n: Whole) returns Text:
    if n == 0:
        return "start";
    else:
        let rest: Text = build(n - 1);
        let piece: Text = be.Text(n);
        return rest & "," & piece;
    end if
end proc build

proc.main:
    let built: Text = build(300);
    show_msg(built);
end proc.main
