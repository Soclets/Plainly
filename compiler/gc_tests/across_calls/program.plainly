proc join_three(Text a, b, c) returns Text:
    let first: Text = a & "-" & b;
    let noise: Text = be.Text(12345) & be.Text(678);
    return first & "-" & c & "/" & noise;
end proc join_three

proc.main:
    let early: Text = join_three("a", "b", "c");
    var last: Text = "none";
    var n: Whole = 0;
    while n < 3000:
        last = join_three(be.Text(n), "mid", last);
        last = join_three(be.Text(n), "mid", "end");
        n = n + 1;
    end while
    show_msg(early);
    show_msg(last);
end proc.main
