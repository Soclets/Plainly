proc.main:
    var big: Text = "ab";
    var n: Whole = 0;
    while n < 15:
        big = big & big;
        n = n + 1;
    end while

    let small: Text = "after the big one";
    var m: Whole = 0;
    while m < 2000:
        let garbage: Text = be.Text(m) & "!";
        m = m + 1;
    end while

    show_msg(small);
    show_msg(big);
end proc.main
